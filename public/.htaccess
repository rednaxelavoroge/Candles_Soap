# Настройка для обычного хостинга с Apache (Namecheap).
# На Vercel этот файл не используется и ни на что не влияет.

# Наш сайт — статические html. index.html должен идти раньше index.php,
# иначе сервер отдаст постороннний index.php, если тот окажется в папке.
DirectoryIndex index.html index.php

# Своя страница «не найдено» вместо стандартной страницы сервера.
ErrorDocument 404 /404.html

# Картинки и шрифты не меняются между сборками — пусть браузер держит их
# у себя и не запрашивает заново. Это заметно ускоряет повторные заходы,
# особенно на плохой связи.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Сжатие текстовых файлов при передаче.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Админка не может работать на обычном хостинге: ей нужен сервер, который
# исполняет код, а здесь лежат готовые файлы. Поэтому она осталась на Vercel,
# а этот адрес просто уводит туда — чтобы Анне было достаточно помнить
# annamanasaryan.art/admin, как было раньше.
#
# Переадресация временная (302), а не постоянная: если однажды админка
# переедет, браузеры не будут держать старый адрес в памяти.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^admin(/.*)?$ https://candles-soap.vercel.app/admin$1 [R=302,L]
</IfModule>
